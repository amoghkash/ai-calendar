# ---------------------------------------------------------------------------
# calendar-agent environment
#
# Copy to .env and fill in what you need. Everything here is optional:
# the application runs with no calendar and no LLM.
# NEVER commit the real .env - it is gitignored.
# ---------------------------------------------------------------------------

# --- core -------------------------------------------------------------------
# CALENDAR_AGENT_TIMEZONE=Europe/Berlin
# CALENDAR_AGENT_CONFIG=./calendar-agent.yaml
# CALENDAR_AGENT_LOG_LEVEL=info

# --- server -----------------------------------------------------------------
# CALENDAR_AGENT_HOST=127.0.0.1
# CALENDAR_AGENT_PORT=4319
# Must match the redirect URIs registered with your calendar providers.
# CALENDAR_AGENT_PUBLIC_URL=http://localhost:4319

# --- periodic sync ----------------------------------------------------------
# The server refreshes calendars on a timer (server only; the CLI is one-shot).
# CALENDAR_AGENT_SYNC_ENABLED=true
# CALENDAR_AGENT_SYNC_INTERVAL_MINUTES=15
# CALENDAR_AGENT_SYNC_REPLAN=true

# --- database ---------------------------------------------------------------
# Default: a single JSON file, no infrastructure required.
# CALENDAR_AGENT_DB_DRIVER=json
# CALENDAR_AGENT_DB_PATH=.data/calendar-agent.json
#
# Setting DATABASE_URL switches to PostgreSQL automatically.
# DATABASE_URL=postgres://calendar:calendar@localhost:5432/calendar_agent

# --- Google Calendar --------------------------------------------------------
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# Redirect URI: http://localhost:4319/api/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4319/api/oauth/google/callback

# --- Microsoft Outlook ------------------------------------------------------
# Entra admin center -> App registrations
# Redirect URI: http://localhost:4319/api/oauth/microsoft/callback
# Delegated scopes: Calendars.ReadWrite, User.Read, MailboxSettings.Read, offline_access
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# MICROSOFT_REDIRECT_URI=http://localhost:4319/api/oauth/microsoft/callback

# --- LLM (optional) ---------------------------------------------------------
# Setting exactly one of these selects the provider automatically.
# Scheduling works fine without any of them.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
#
# Or configure it explicitly:
# CALENDAR_AGENT_LLM_PROVIDER=anthropic
# CALENDAR_AGENT_LLM_MODEL=claude-opus-5
# CALENDAR_AGENT_LLM_BASE_URL=http://localhost:11434/v1
